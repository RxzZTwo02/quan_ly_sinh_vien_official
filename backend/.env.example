# Sao chép thành .env nếu cần đổi cấu hình. Giá trị dưới đây là mặc định của Laragon.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qlsv
# Database rỗng (chưa có dữ liệu) thì nạp dữ liệu mẫu từ sql/seed.sql: yes (mặc định) hoặc no.
# Đặt no TRƯỚC lần chạy đầu nếu muốn bắt đầu với database trống.
SEED_DATA=yes

API_HOST=127.0.0.1
API_PORT=5001
# Tùy chọn: nếu đặt, front-end phải dùng cùng giá trị API_TOKEN.
API_TOKEN=
